generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  phone        String
  city         String
  monthly_bill String
  roof_type    String
  capacity     String
  created_at   DateTime @default(now())
}
